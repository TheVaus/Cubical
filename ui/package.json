{
  "name": "cubical-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Solid + TypeScript + Vite frontend for Cubical. Owned by Vite; builds into ../crates/cubical-app/../../ui/dist consumed by Tauri.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/common": "^1.2.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "codemirror": "^6.0.1",
    "solid-js": "^1.9.14",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^3.2.7"
  }
}
