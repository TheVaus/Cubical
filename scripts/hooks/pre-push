#!/usr/bin/env bash
# Fast checks only — the ones that are cheap and that CI cannot recover from
# afterwards. The full gate belongs to CI; duplicating it here just makes push
# slow enough that people reach for --no-verify.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

fail=0

# Generated-doc drift: cheap (no build), and pushing a stale artifact means the
# next reader trusts a file that no longer describes the tree.
for g in gen_repo_layout gen_ipc_surface gen_ds_inventory gen_principles_readme; do
  if ! python3 "scripts/$g.py" --check >/dev/null 2>&1; then
    echo "pre-push: a generated artifact is stale — run: python3 scripts/$g.py"
    echo "  rule: docs/principles/generated-artifacts.md"
    fail=1
  fi
done

# Graph staleness: a warning, not a block. It costs money to fix and it cannot
# break anything that is being pushed.
GRAPH="graphify-out/graph.json"
if [ -f "$GRAPH" ]; then
  if stat -f %m "$GRAPH" >/dev/null 2>&1; then gm=$(stat -f %m "$GRAPH"); else gm=$(stat -c %Y "$GRAPH"); fi
  if [ "$gm" -lt "$(git log -1 --format=%ct)" ]; then
    echo "pre-push: warn — the knowledge graph is older than HEAD; scripts/graph.sh will refuse."
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo
  echo "Blocked on correctness. Bookkeeping warnings above do not block."
  exit 1
fi
