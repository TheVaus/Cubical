{
  "_": [
    "Read by scripts/gates/domain_boundary.py. The rule is",
    "docs/principles/domain-scoped-dependencies.md.",
    "",
    "Three classes, and the class is the whole rule:",
    "",
    "  substrate — always on. Anything may depend on it. It may depend on",
    "              nothing but other substrate. Switching it off is not a",
    "              feature request, it is a different product.",
    "  block     — removable. It may depend on substrate and on its own",
    "              domain. It may NOT depend on another domain's block: that",
    "              is what makes two features fail together.",
    "  shell     — the composition root. It exists to know every block, so it",
    "              is exempt. Keeping the exempt set small is the point; a",
    "              shell that grows logic has stopped being a composition root.",
    "",
    "`allowed` is a GRANDFATHER LIST, not a design. Every entry is a violation",
    "that predates the gate, kept so the gate could land green rather than",
    "block unrelated work. Entries come off as the code is touched; nothing is",
    "added without an issue number saying why the edge cannot be removed."
  ],

  "crates": {
    "cubical-ast":    { "class": "substrate", "domain": "document" },
    "cubical-index":  { "class": "substrate", "domain": "index" },
    "cubical-core":   { "class": "substrate", "domain": "vault" },
    "cubical-search": { "class": "block",     "domain": "search" },
    "cubical-graph":  { "class": "block",     "domain": "graph" },
    "cubical-query":  { "class": "block",     "domain": "dataview" },
    "cubical-table":  { "class": "block",     "domain": "dataview" },
    "cubical-sync":   { "class": "block",     "domain": "sync" },
    "cubical-engine": { "class": "shell",     "domain": "engine" },
    "cubical-ipc":    { "class": "shell",     "domain": "engine" },
    "cubical-app":    { "class": "shell",     "domain": "app" },
    "cubical-cli":    { "class": "shell",     "domain": "app" }
  },

  "crate_allowed": {},

  "engine_modules": {
    "_": "crates/cubical-engine/src/commands/*. Anything not listed is shell.",
    "open":        { "class": "substrate", "domain": "vault" },
    "paths":       { "class": "substrate", "domain": "vault" },
    "vault":       { "class": "substrate", "domain": "vault" },
    "snippet":     { "class": "substrate", "domain": "vault" },
    "link_match":  { "class": "substrate", "domain": "links" },
    "links":       { "class": "substrate", "domain": "links" },
    "backlinks":   { "class": "substrate", "domain": "links" },
    "mentions":    { "class": "substrate", "domain": "links" },
    "tags":        { "class": "substrate", "domain": "tags" },
    "rename":      { "class": "substrate", "domain": "rename" },
    "autocomplete": { "class": "block", "domain": "autocomplete" },
    "blocks":      { "class": "block", "domain": "blocks" },
    "dataview":    { "class": "block", "domain": "dataview" },
    "embeds":      { "class": "block", "domain": "embeds" },
    "graph":       { "class": "block", "domain": "graph" },
    "integrity":   { "class": "block", "domain": "integrity" },
    "property_ref": { "class": "block", "domain": "property-refs" },
    "search":      { "class": "block", "domain": "search" }
  },

  "engine_support": {
    "_": [
      "crates/cubical-engine/src/* modules outside commands/ that belong to",
      "one domain, checked both as sources and as targets. The engine crate",
      "is shell, so without this a block's handle moved beside commands/, or",
      "substrate such as the watcher living in events.rs, would be invisible.",
      "Anything unlisted here (state, compose, plugins, api, error) is shell."
    ],
    "events":        { "class": "substrate", "domain": "vault" },
    "rename_pairing": { "class": "substrate", "domain": "rename" },
    "vault_lock":    { "class": "substrate", "domain": "vault" },
    "search_handle": { "class": "block", "domain": "search" }
  },

  "engine_allowed": {},

  "ui_domains": {
    "_": [
      "A directory under ui/src is a domain; a bare file under ui/src is its",
      "own domain named after the file. A key with a slash is a path prefix",
      "inside a directory and the longest match wins: that is how the editor",
      "directory holds the always-on editor core and each preview feature as",
      "separate domains. Anything unlisted defaults to block, so a new feature",
      "directory is fenced in from its first commit."
    ],
    "api":        { "class": "substrate", "domain": "ipc" },
    "api/autocomplete": { "class": "block", "domain": "autocomplete" },
    "api/blocks": { "class": "block", "domain": "blocks" },
    "api/dataview": { "class": "block", "domain": "dataview" },
    "api/embeds": { "class": "block", "domain": "embeds" },
    "api/graph": { "class": "block", "domain": "graph" },
    "api/integrity": { "class": "block", "domain": "integrity" },
    "api/propertyRef": { "class": "block", "domain": "property-refs" },
    "api/search": { "class": "block", "domain": "search" },
    "api/terminal": { "class": "block", "domain": "terminal" },
    "ast":        { "class": "substrate", "domain": "document" },
    "core":       { "class": "substrate", "domain": "core" },
    "vault":      { "class": "substrate", "domain": "vault" },
    "styles":     { "class": "substrate", "domain": "styles" },
    "toast":      { "class": "substrate", "domain": "toast" },

    "App":        { "class": "shell", "domain": "shell" },
    "main":       { "class": "shell", "domain": "shell" },
    "shell":      { "class": "shell", "domain": "shell" },

    "editor":     { "class": "substrate", "domain": "editor" },
    "editor/math":         { "class": "block", "domain": "math" },
    "editor/equation":     { "class": "block", "domain": "equations" },
    "editor/calcBlock":    { "class": "block", "domain": "equations" },
    "editor/expr":         { "class": "block", "domain": "equations" },
    "editor/propertyRef":  { "class": "block", "domain": "property-refs" },
    "editor/propertyResolver": { "class": "block", "domain": "property-refs" },
    "editor/dataview":     { "class": "block", "domain": "dataview" },
    "editor/embed":        { "class": "block", "domain": "embeds" },
    "editor/autocomplete": { "class": "block", "domain": "autocomplete" },
    "editor/csvBlock":     { "class": "block", "domain": "csv" },
    "properties": { "class": "block", "domain": "properties" },
    "tags":       { "class": "block", "domain": "tags" },
    "vaultSwitcher": { "class": "block", "domain": "vault-switcher" },
    "dataview":   { "class": "block", "domain": "dataview" },
    "explorer":   { "class": "block", "domain": "explorer" },
    "graph":      { "class": "block", "domain": "graph" },
    "omnibar":    { "class": "block", "domain": "omnibar" },
    "search":     { "class": "block", "domain": "search" },
    "backlinks":  { "class": "block", "domain": "backlinks" },
    "integrity":  { "class": "block", "domain": "integrity" },
    "settings":   { "class": "substrate", "domain": "settings" },
    "statusbar":  { "class": "block", "domain": "statusbar" },
    "tabs":       { "class": "substrate", "domain": "tabs" },
    "terminal":   { "class": "block", "domain": "terminal" },
    "viewer":     { "class": "block", "domain": "viewer" }
  },

  "ui_allowed": {}
}
